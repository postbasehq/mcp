{
  "name": "@postbasehq/mcp",
  "mcpName": "io.github.postbasehq/postbase",
  "version": "0.3.0",
  "description": "MCP server for Postbase, the open-source social media scheduler: let Claude, Cursor or any MCP client schedule, edit, check and retry posts, threads, images and video on X, LinkedIn, Bluesky, Mastodon and YouTube, and read their analytics.",
  "type": "module",
  "bin": {
    "postbase-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "postbase",
    "social-media",
    "social-media-scheduler",
    "scheduler",
    "claude",
    "cursor",
    "ai-agent",
    "x",
    "twitter",
    "linkedin",
    "bluesky",
    "mastodon"
  ],
  "author": "Berkway Group Limited",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://www.postbase.so/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postbasehq/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/postbasehq/mcp/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2"
  }
}
